# ============================================
# Tanzania Safari Magic - Environment Variables
# ============================================

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# For Render: Use the DATABASE_URL provided by Render
# For local: postgresql://user:password@localhost:5432/dbname?sslmode=disable
DATABASE_URL=postgresql://user:password@localhost:5432/tanzania_safari?sslmode=disable

# ============================================
# Application Settings
# ============================================
# Server port (Render will set this automatically)
PORT=3000
# Environment: development, staging, production
NODE_ENV=development
# Generate a strong 64-character hex string for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-development-key-change-in-production

# ============================================
# Email Configuration (Namecheap Private Email)
# ============================================
# SMTP host
EMAIL_HOST=mail.privateemail.com
# SMTP port (587 for STARTTLS, 465 for SSL)
EMAIL_PORT=587
# Use SSL/TLS (true for port 465, false for port 587)
EMAIL_SECURE=false
# SMTP username
EMAIL_USER=info@tanzaniasafarimagic.com
# SMTP password
EMAIL_PASS=your_email_password
# From email address
EMAIL_FROM="Tanzania Safari Magic <info@tanzaniasafarimagic.com>"
# Admin email for notifications
ADMIN_EMAIL=info@tanzaniasafarimagic.com
# Admin panel URL
ADMIN_URL=http://localhost:3000/admin
# Main site URL
SITE_URL=https://tanzaniasafarimagic.com
# Optional Search Console / Bing verification tokens (injected into HTML head)
# GOOGLE_SITE_VERIFICATION=your_google_token
# BING_SITE_VERIFICATION=your_bing_token

# ============================================
# Redis Configuration (Optional - for email queue)
# ============================================
# Redis connection URL (optional - app will work without Redis)
# Used for email queue AND Socket.io multi-instance chat scaling
# For Render: Use the REDIS_URL provided by Render
# For local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# Email Queue Configuration
# ============================================
# Number of concurrent email workers
QUEUE_CONCURRENCY=5
# Number of retry attempts for failed emails
QUEUE_RETRY_ATTEMPTS=5
# Backoff delay in milliseconds for retries
QUEUE_BACKOFF_MS=5000

# ============================================
# Email Rate Limiting
# ============================================
# Maximum emails per minute
EMAIL_MAX_PER_MINUTE=20
# Maximum emails per hour
EMAIL_MAX_PER_HOUR=200

# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# For production: https://tanzaniasafarimagic.com,https://www.tanzaniasafarimagic.com
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173

# ============================================
# File Upload Configuration
# ============================================
# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760
# Allowed file extensions
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.webp

# ============================================
# Session Configuration
# ============================================
# Session secret (generate random string)
SESSION_SECRET=your-session-secret-change-in-production
# Session max age in milliseconds (12 hours)
SESSION_MAX_AGE=43200000
