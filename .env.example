# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?sslmode=disable

# Application settings
PORT=3000
NODE_ENV=development
# Generate a strong 64-character hex string for production: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=your-super-secret-development-key-change-in-production

# Mail and Admin settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
ADMIN_EMAIL=admin@tanzaniasafari.com
ADMIN_URL=http://localhost:3000/admin
ALLOWED_ORIGIN=http://localhost:3000
