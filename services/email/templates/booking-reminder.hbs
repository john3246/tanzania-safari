{{#with booking}}
<p>Dear <strong>{{full_name}}</strong>,</p>

<p>This is a friendly reminder that your safari adventure is coming up soon!</p>

<div class="divider"></div>

<div class="row">
  <span class="label">Booking Reference</span>
  <span class="value">#{{booking_reference}}</span>
</div>
<div class="row">
  <span class="label">Package</span>
  <span class="value">{{package_name}}</span>
</div>
<div class="row">
  <span class="label">Travel Date</span>
  <span class="value">{{formatDate start_date}}</span>
</div>
<div class="row">
  <span class="label">Days Until Safari</span>
  <span class="value">{{days_until}}</span>
</div>

<div class="divider"></div>

<p>Please ensure you have completed all preparations for your trip. If you have any questions, don't hesitate to reach out.</p>

<p>We look forward to welcoming you to Tanzania!</p>
{{/with}}
