{{#with payment}}
<p>Dear <strong>{{customer_name}}</strong>,</p>

<p>Your payment has been processed successfully!</p>

<div class="divider"></div>

<div class="row">
  <span class="label">Payment ID</span>
  <span class="value">{{payment_id}}</span>
</div>
<div class="row">
  <span class="label">Booking Reference</span>
  <span class="value">#{{booking_reference}}</span>
</div>
<div class="row">
  <span class="label">Amount</span>
  <span class="value">${{formatPrice amount}} USD</span>
</div>
<div class="row">
  <span class="label">Payment Date</span>
  <span class="value">{{formatDate payment_date}}</span>
</div>
<div class="row">
  <span class="label">Status</span>
  <span class="value"><span class="badge badge-success">Paid</span></span>
</div>

<div class="divider"></div>

<p>Your booking is now confirmed. Thank you for your payment!</p>
{{/with}}
