{{#with booking}}
<p>Dear <strong>{{full_name}}</strong>,</p>

<p>We regret to inform you that your booking request could not be confirmed at this time.</p>

<div class="divider"></div>

<div class="row">
  <span class="label">Booking Reference</span>
  <span class="value">#{{booking_reference}}</span>
</div>
<div class="row">
  <span class="label">Package</span>
  <span class="value">{{package_name}}</span>
</div>
<div class="row">
  <span class="label">Requested Date</span>
  <span class="value">{{formatDate start_date}}</span>
</div>
<div class="row">
  <span class="label">Status</span>
  <span class="value"><span class="badge badge-error">Rejected</span></span>
</div>

<div class="divider"></div>

<p>This may be due to limited availability or scheduling conflicts. Please contact us to explore alternative dates or packages.</p>

<p>We apologize for any inconvenience and hope to serve you in the future.</p>
{{/with}}
