{{#with alert}}
<p class="greeting"><strong>System alert: {{alert_type}}</strong></p>
<p class="lead">Please investigate as soon as possible. Details below.</p>

<div class="data-card">
  {{#if timestamp}}
  <div class="row"><span class="label">Timestamp</span><span class="value">{{timestamp}}</span></div>
  {{/if}}
  {{#if severity}}
  <div class="row"><span class="label">Severity</span><span class="value">{{severity}}</span></div>
  {{/if}}
</div>

{{#if error_message}}
<p class="section-label">Error message</p>
<div class="info-box danger">{{error_message}}</div>
{{/if}}

{{#if details}}
<p class="section-label">Details</p>
<pre style="background:#f6f9f5;border:1px solid #e0e8dd;border-radius:12px;padding:16px;font-size:13px;overflow:auto;white-space:pre-wrap;">{{details}}</pre>
{{/if}}
{{/with}}
