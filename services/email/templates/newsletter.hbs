{{#with content}}
<p>Dear Safari Enthusiast,</p>

<p>Welcome to the latest edition of the Tanzania Safari Magic newsletter!</p>

{{#if featured_post}}
<div class="divider"></div>
<h2>{{featured_post.post_title}}</h2>
<p>{{featured_post.post_excerpt}}</p>
<div style="text-align: center; margin: 24px 0;">
  <a href="{{site_url}}/blog/{{featured_post.post_slug}}" class="btn">Read Full Story</a>
</div>
{{/if}}

{{#if featured_package}}
<div class="divider"></div>
<h2>Featured Safari Package</h2>
<p><strong>{{featured_package.package_name}}</strong></p>
<p>{{featured_package.short_description}}</p>
<div class="row">
  <span class="label">Duration</span>
  <span class="value">{{featured_package.duration_days}} days</span>
</div>
<div class="row">
  <span class="label">Price</span>
  <span class="value">${{formatPrice featured_package.price_usd}} USD</span>
</div>
<div style="text-align: center; margin: 24px 0;">
  <a href="{{site_url}}/safari/{{featured_package.package_slug}}" class="btn">View Package</a>
</div>
{{/if}}

<div class="divider"></div>

<p>Explore all our <a href="{{site_url}}/safaris">safari packages</a> and start planning your adventure today!</p>

<p style="font-size: 12px; color: #888;">
  You received this email because you subscribed to our newsletter. 
  <a href="{{unsubscribe_url}}">Unsubscribe</a>
</p>
{{/with}}
