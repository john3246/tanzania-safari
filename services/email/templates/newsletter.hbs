{{#with content}}
<p class="greeting">Dear safari enthusiast,</p>

<p class="lead">
  Welcome to the latest edition from <strong>Tanzania Safari Magic</strong> — stories, seasonal tips, and journey ideas from our team on the ground in Arusha.
</p>

{{#if featured_post}}
<p class="section-label">Featured story</p>
<h2 style="margin-top:0;">{{featured_post.post_title}}</h2>
<p>{{featured_post.post_excerpt}}</p>
<div class="cta-row">
  <a href="{{site_url}}/blog/{{featured_post.post_slug}}" class="btn">Read the full story</a>
</div>
{{/if}}

{{#if featured_package}}
<p class="section-label">Featured safari</p>
<div class="data-card">
  <div class="row">
    <span class="label">Package</span>
    <span class="value">{{featured_package.package_name}}</span>
  </div>
  {{#if featured_package.duration_days}}
  <div class="row">
    <span class="label">Duration</span>
    <span class="value">{{featured_package.duration_days}} days</span>
  </div>
  {{/if}}
  {{#if featured_package.price_usd}}
  <div class="row">
    <span class="label">From</span>
    <span class="value">${{formatPrice featured_package.price_usd}} USD</span>
  </div>
  {{/if}}
</div>
{{#if featured_package.short_description}}
<p>{{featured_package.short_description}}</p>
{{/if}}
<div class="cta-row">
  <a href="{{site_url}}/safaris/{{featured_package.package_slug}}" class="btn">View this package</a>
</div>
{{/if}}

<div class="info-box">
  Ready to turn inspiration into dates on the calendar?
  <a href="{{site_url}}/booking">Request a free custom quote</a>
  or browse all <a href="{{site_url}}/safaris">safari packages</a>.
</div>

<p style="font-size:12px;color:#94a3b8;margin-top:20px;">
  You received this email because you subscribed to our newsletter.
  <a href="{{unsubscribe_url}}">Unsubscribe</a>
</p>
{{/with}}
