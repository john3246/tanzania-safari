<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{subject}}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #FBF6EE;
      color: #2A1A0E;
      -webkit-font-smoothing: antialiased;
    }
    .wrapper {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }
    .header {
      background: linear-gradient(135deg, #C8860A, #C25B2A);
      padding: 32px 40px;
      text-align: center;
      color: #ffffff;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .header p {
      margin: 6px 0 0;
      opacity: 0.9;
      font-size: 14px;
    }
    .body {
      padding: 40px;
    }
    .body h2 {
      margin-top: 0;
      color: #C25B2A;
      font-size: 20px;
    }
    .row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid #F0E4CC;
      font-size: 14px;
    }
    .row:last-child {
      border: none;
    }
    .label {
      color: #8A6E54;
      font-weight: 500;
    }
    .value {
      font-weight: 600;
      color: #2A1A0E;
      text-align: right;
    }
    .btn {
      display: inline-block;
      background: linear-gradient(135deg, #C8860A, #A36A00);
      color: #ffffff;
      padding: 14px 32px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      margin: 24px 0;
    }
    .btn:hover {
      opacity: 0.9;
    }
    .footer {
      background: #FBF6EE;
      padding: 24px 40px;
      text-align: center;
      font-size: 12px;
      color: #8A6E54;
    }
    .footer a {
      color: #C25B2A;
      text-decoration: none;
    }
    .badge {
      display: inline-block;
      background: #E8F5E9;
      color: #2E7D32;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-warning {
      background: #FFF3E0;
      color: #E65100;
    }
    .badge-error {
      background: #FFEBEE;
      color: #C62828;
    }
    .badge-success {
      background: #E8F5E9;
      color: #2E7D32;
    }
    .divider {
      border: none;
      border-top: 1px solid #F0E4CC;
      margin: 24px 0;
    }
    @media only screen and (max-width: 600px) {
      .wrapper {
        width: 100%;
        border-radius: 0;
      }
      .header, .body, .footer {
        padding: 24px 20px;
      }
      .row {
        flex-direction: column;
      }
      .value {
        text-align: left;
        margin-top: 4px;
      }
    }
  </style>
</head>
<body>
  <div style="padding: 24px;">
    <div class="wrapper">
      {{#if header}}
      <div class="header">
        <img src="https://tanzania-safari.onrender.com/images/logo.png" alt="Tanzania Safari Magic Logo" style="max-height: 80px; margin-bottom: 16px;">
        <h1>{{header.title}}</h1>
        <p>{{header.subtitle}}</p>
      </div>
      {{else}}
      <div class="header">
        <img src="https://tanzania-safari.onrender.com/images/logo.png" alt="Tanzania Safari Magic Logo" style="max-height: 80px; margin-bottom: 16px;">
        <h1>Tanzania Safari Magic</h1>
      </div>
      {{/if}}
      
      <div class="body">
        {{{body}}}
      </div>
      
      {{#if footer}}
      <div class="footer">
        {{{footer}}}
      </div>
      {{else}}
      <div class="footer">
        <p>Tanzania Safari Magic · Arusha, Tanzania</p>
        <p><a href="mailto:info@tanzaniasafarimagic.com">info@tanzaniasafarimagic.com</a></p>
        <p style="margin-top: 12px;">This is an automated message. Please do not reply directly.</p>
      </div>
      {{/if}}
    </div>
  </div>
</body>
</html>
