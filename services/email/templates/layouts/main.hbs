<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{subject}}</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style type="text/css">
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      background-color: #f4f6f3;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
      color: #334155;
      line-height: 1.6;
    }
    .email-shell { width: 100%; background-color: #f4f6f3; padding: 28px 12px; }
    .email-card {
      max-width: 640px;
      width: 100%;
      background: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid #e5ebe3;
    }
    .brand-bar {
      background: linear-gradient(135deg, #1E311B 0%, #263E22 55%, #365730 100%);
      padding: 28px 32px 24px;
      text-align: center;
    }
    .brand-bar img { max-height: 56px; margin: 0 auto 14px; display: block; background: #fff; border-radius: 10px; padding: 6px; }
    .brand-bar h1 {
      margin: 0;
      font-size: 22px;
      line-height: 1.25;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
    }
    .brand-bar p {
      margin: 8px 0 0;
      font-size: 14px;
      color: rgba(255,255,255,0.88);
    }
    .accent-line { height: 4px; background: #FF6F00; width: 100%; }
    .email-body { padding: 32px 28px; color: #475569; font-size: 15px; }
    .email-body h2 { margin: 0 0 14px; color: #1E311B; font-size: 20px; font-weight: 700; }
    .email-body p { margin: 0 0 16px; }
    .email-body a { color: #C45500; font-weight: 600; }
    .data-card {
      background: #f7f9f6;
      border: 1px solid #e5ebe3;
      border-radius: 12px;
      padding: 8px 18px;
      margin: 20px 0;
    }
    .row {
      padding: 12px 0;
      border-bottom: 1px dashed #d5ddd2;
      font-size: 14px;
    }
    .row:last-child { border-bottom: none; }
    .label { color: #64748b; font-weight: 600; display: block; margin-bottom: 2px; }
    .value { color: #1e293b; font-weight: 700; }
    .btn {
      display: inline-block;
      background: #FF6F00;
      color: #ffffff !important;
      padding: 14px 28px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      font-size: 15px;
      margin: 8px 0 4px;
    }
    .btn-secondary {
      display: inline-block;
      background: #263E22;
      color: #ffffff !important;
      padding: 14px 28px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      font-size: 15px;
      margin: 8px 8px 4px 0;
    }
    .badge {
      display: inline-block;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      background: #fff3e6;
      color: #C45500;
    }
    .badge-success { background: #dcfce7; color: #15803d; }
    .badge-error { background: #fee2e2; color: #b91c1c; }
    .badge-warning { background: #fef3c7; color: #b45309; }
    .divider { border: none; border-top: 1px solid #eef2ee; margin: 24px 0; }
    .email-footer {
      background: #f0f3ef;
      padding: 24px 28px;
      text-align: center;
      font-size: 13px;
      color: #64748b;
    }
    .email-footer a { color: #263E22; font-weight: 700; text-decoration: none; }
    .trust {
      margin-top: 14px;
      font-size: 12px;
      color: #94a3b8;
    }
    @media only screen and (max-width: 600px) {
      .email-shell { padding: 0 !important; }
      .email-card { border-radius: 0 !important; border-left: 0 !important; border-right: 0 !important; }
      .brand-bar, .email-body, .email-footer { padding-left: 20px !important; padding-right: 20px !important; }
      .btn, .btn-secondary { display: block !important; width: 100% !important; box-sizing: border-box !important; text-align: center !important; margin: 8px 0 !important; }
    }
  </style>
</head>
<body>
  <div class="email-shell">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center">
          <table role="presentation" class="email-card" width="640" cellspacing="0" cellpadding="0" border="0">
            <tr>
              <td class="brand-bar">
                <img src="https://tanzaniasafarimagic.com/images/logo.png" width="56" height="56" alt="Tanzania Safari Magic">
                {{#if header}}
                <h1>{{header.title}}</h1>
                {{#if header.subtitle}}<p>{{header.subtitle}}</p>{{/if}}
                {{else}}
                <h1>Tanzania Safari Magic</h1>
                <p>Private safaris from Arusha · Serengeti · Ngorongoro · Zanzibar</p>
                {{/if}}
              </td>
            </tr>
            <tr><td class="accent-line"></td></tr>
            <tr>
              <td class="email-body">
                {{{body}}}
              </td>
            </tr>
            <tr>
              <td class="email-footer">
                {{#if footer}}
                  {{{footer}}}
                {{else}}
                  <p style="margin:0 0 6px;"><strong style="color:#1E311B;">Tanzania Safari Magic</strong></p>
                  <p style="margin:0 0 6px;">Arusha, Tanzania</p>
                  <p style="margin:0 0 10px;">
                    <a href="mailto:info@tanzaniasafarimagic.com">info@tanzaniasafarimagic.com</a>
                    &nbsp;·&nbsp;
                    <a href="https://wa.me/255695108009">+255 695 108 009</a>
                  </p>
                  <p style="margin:0 0 8px;">
                    <a href="https://tanzaniasafarimagic.com/safaris">Safaris</a> ·
                    <a href="https://tanzaniasafarimagic.com/destinations">Destinations</a> ·
                    <a href="https://tanzaniasafarimagic.com/blog">Blog</a> ·
                    <a href="https://tanzaniasafarimagic.com/booking">Get a Quote</a>
                  </p>
                  <p class="trust">Licensed local operator · TripAdvisor travellers · Transparent private itineraries</p>
                {{/if}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
