<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{subject}}</title>
  <style>
    :root {
      --primary: #263E22;
      --accent: #D4AF37;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #f8f9fa;
      color: #334155;
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }
    .wrapper {
      max-width: 640px;
      margin: 40px auto;
      background: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.08);
    }
    .header {
      background: linear-gradient(135deg, #1e331b 0%, #263E22 100%);
      padding: 48px 40px;
      text-align: center;
      color: #ffffff;
      border-bottom: 5px solid #D4AF37;
      position: relative;
    }
    .header::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: url('https://www.transparenttextures.com/patterns/cubes.png') opacity(0.05);
      pointer-events: none;
    }
    .header img {
      max-height: 70px;
      margin-bottom: 24px;
      filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: #ffffff;
    }
    .header p {
      margin: 8px 0 0;
      opacity: 0.85;
      font-size: 15px;
      color: #e2e8f0;
      font-weight: 500;
    }
    .body {
      padding: 48px 40px;
    }
    .body h2 {
      margin-top: 0;
      color: #263E22;
      font-size: 22px;
      font-weight: 700;
      border-bottom: 2px solid #f1f5f9;
      padding-bottom: 12px;
    }
    .body p {
      font-size: 15px;
      color: #475569;
      margin-bottom: 20px;
    }
    .data-card {
      background: #f8fafc;
      border-radius: 12px;
      padding: 24px;
      margin: 24px 0;
      border: 1px solid #e2e8f0;
    }
    .row {
      display: flex;
      justify-content: space-between;
      padding: 14px 0;
      border-bottom: 1px dashed #cbd5e1;
      font-size: 15px;
    }
    .row:last-child {
      border: none;
      padding-bottom: 0;
    }
    .row:first-child {
      padding-top: 0;
    }
    .label {
      color: #64748b;
      font-weight: 600;
    }
    .value {
      font-weight: 700;
      color: #1e293b;
      text-align: right;
    }
    .btn {
      display: inline-block;
      background: #D4AF37;
      color: #ffffff !important;
      padding: 16px 36px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      font-size: 16px;
      margin: 32px 0;
      transition: all 0.3s ease;
      text-align: center;
      box-shadow: 0 4px 14px rgba(212, 175, 55, 0.4);
    }
    .btn:hover {
      background: #b5952f;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(212, 175, 55, 0.5);
    }
    .footer {
      background: #f1f5f9;
      padding: 32px 40px;
      text-align: center;
      font-size: 13px;
      color: #64748b;
    }
    .footer a {
      color: #D4AF37;
      text-decoration: none;
      font-weight: 600;
    }
    .footer .socials {
      margin-top: 16px;
      margin-bottom: 16px;
    }
    .socials a {
      margin: 0 8px;
      color: #263E22;
      font-size: 18px;
    }
    .badge {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 50px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .badge-warning {
      background: #fef3c7;
      color: #b45309;
    }
    .badge-error {
      background: #fee2e2;
      color: #b91c1c;
    }
    .badge-success {
      background: #dcfce7;
      color: #15803d;
    }
    .divider {
      border: none;
      border-top: 2px solid #f1f5f9;
      margin: 32px 0;
    }
    @media only screen and (max-width: 600px) {
      .wrapper {
        width: 100%;
        margin: 0;
        border-radius: 0;
      }
      .header, .body, .footer {
        padding: 32px 24px;
      }
      .row {
        flex-direction: column;
      }
      .value {
        text-align: left;
        margin-top: 6px;
      }
      .btn {
        display: block;
        width: 100%;
        box-sizing: border-box;
      }
    }
  </style>
</head>
<body>
  <div style="padding: 24px 0;">
    <div class="wrapper">
      {{#if header}}
      <div class="header">
        <img src="https://tanzania-safari.onrender.com/images/logo.png" alt="Tanzania Safari Logo">
        <h1>{{header.title}}</h1>
        <p>{{header.subtitle}}</p>
      </div>
      {{else}}
      <div class="header">
        <img src="https://tanzania-safari.onrender.com/images/logo.png" alt="Tanzania Safari Logo">
        <h1>Tanzania Safari Magic</h1>
        <p>Premium Safari Experiences in Tanzania</p>
      </div>
      {{/if}}
      
      <div class="body">
        {{{body}}}
      </div>
      
      <div class="footer">
        {{#if footer}}
          {{{footer}}}
        {{else}}
          <p style="margin: 0 0 8px;"><strong>Tanzania Safari Magic</strong> · Arusha, Tanzania</p>
          <p style="margin: 0 0 16px;"><a href="mailto:info@tanzaniasafarimagic.com">info@tanzaniasafarimagic.com</a></p>
          <p style="font-size: 12px; opacity: 0.7;">This is an automated message. Please do not reply directly to this email.</p>
        {{/if}}
      </div>
    </div>
  </div>
</body>
</html>
