<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{subject}}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f4f7f6;
      color: #333333;
      -webkit-font-smoothing: antialiased;
    }
    .wrapper {
      max-width: 600px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }
    .header {
      background: #263E22;
      padding: 32px 40px;
      text-align: center;
      color: #ffffff;
      border-bottom: 4px solid #D4AF37;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: 0.5px;
      color: #ffffff;
    }
    .header p {
      margin: 6px 0 0;
      opacity: 0.9;
      font-size: 14px;
      color: #e0e0e0;
    }
    .body {
      padding: 40px;
    }
    .body h2 {
      margin-top: 0;
      color: #263E22;
      font-size: 20px;
      border-bottom: 2px solid #f0f0f0;
      padding-bottom: 10px;
    }
    .row {
      display: flex;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #f0f0f0;
      font-size: 14px;
    }
    .row:last-child {
      border: none;
    }
    .label {
      color: #666666;
      font-weight: 500;
    }
    .value {
      font-weight: 600;
      color: #263E22;
      text-align: right;
    }
    .btn {
      display: inline-block;
      background: #D4AF37;
      color: #1a2917;
      padding: 14px 32px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 700;
      font-size: 15px;
      margin: 24px 0;
      transition: background 0.3s ease;
    }
    .btn:hover {
      background: #c29d2f;
    }
    .footer {
      background: #f9fafa;
      padding: 24px 40px;
      text-align: center;
      font-size: 12px;
      color: #888888;
      border-top: 1px solid #eeeeee;
    }
    .footer a {
      color: #D4AF37;
      text-decoration: none;
      font-weight: 600;
    }
    .badge {
      display: inline-block;
      background: #E8F5E9;
      color: #2E7D32;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-warning {
      background: #FFF3E0;
      color: #E65100;
    }
    .badge-error {
      background: #FFEBEE;
      color: #C62828;
    }
    .badge-success {
      background: #E8F5E9;
      color: #2E7D32;
    }
    .divider {
      border: none;
      border-top: 1px solid #eeeeee;
      margin: 24px 0;
    }
    @media only screen and (max-width: 600px) {
      .wrapper {
        width: 100%;
        border-radius: 0;
      }
      .header, .body, .footer {
        padding: 24px 20px;
      }
      .row {
        flex-direction: column;
      }
      .value {
        text-align: left;
        margin-top: 4px;
      }
    }
  </style>
</head>
<body>
  <div style="padding: 24px 0;">
    <div class="wrapper">
      {{#if header}}
      <div class="header">
        <img src="https://tanzania-safari.onrender.com/images/logo.png" alt="Tanzania Safari Logo" style="max-height: 80px; margin-bottom: 16px; filter: brightness(0) invert(1);">
        <h1>{{header.title}}</h1>
        <p>{{header.subtitle}}</p>
      </div>
      {{else}}
      <div class="header">
        <img src="https://tanzania-safari.onrender.com/images/logo.png" alt="Tanzania Safari Logo" style="max-height: 80px; margin-bottom: 16px; filter: brightness(0) invert(1);">
        <h1>Tanzania Safari</h1>
      </div>
      {{/if}}
      
      <div class="body">
        {{{body}}}
      </div>
      
      {{#if footer}}
      <div class="footer">
        {{{footer}}}
      </div>
      {{else}}
      <div class="footer">
        <p>Tanzania Safari · Arusha, Tanzania</p>
        <p><a href="mailto:info@tanzaniasafari.com">info@tanzaniasafari.com</a></p>
        <p style="margin-top: 12px; font-size: 11px; opacity: 0.7;">This is an automated message. Please do not reply directly.</p>
      </div>
      {{/if}}
    </div>
  </div>
</body>
</html>
