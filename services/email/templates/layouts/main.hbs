<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{subject}}</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style type="text/css">
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    body {
      margin: 0 !important;
      padding: 0 !important;
      width: 100% !important;
      background-color: #eef2eb;
      font-family: Georgia, 'Times New Roman', 'Segoe UI', Helvetica, Arial, sans-serif;
      color: #2c3829;
      line-height: 1.65;
    }
    .email-shell { width: 100%; background-color: #eef2eb; padding: 32px 14px; }
    .email-card {
      max-width: 640px;
      width: 100%;
      background: #ffffff;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid #d9e3d6;
    }
    .brand-bar {
      background: linear-gradient(135deg, #1E311B 0%, #263E22 55%, #365730 100%);
      padding: 30px 32px 26px;
      text-align: center;
    }
    .brand-bar img {
      max-height: 56px;
      margin: 0 auto 14px;
      display: block;
      background: #fff;
      border-radius: 10px;
      padding: 6px;
    }
    .brand-bar h1 {
      margin: 0;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 22px;
      line-height: 1.25;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
    }
    .brand-bar p {
      margin: 8px 0 0;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 14px;
      color: rgba(255,255,255,0.9);
    }
    .accent-line { height: 4px; background: #FF6F00; width: 100%; }
    .email-body {
      padding: 34px 30px 18px;
      color: #3d4a3a;
      font-size: 16px;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .email-body h2 {
      margin: 0 0 12px;
      color: #1E311B;
      font-size: 20px;
      font-weight: 750;
      line-height: 1.3;
    }
    .email-body h3 {
      margin: 22px 0 10px;
      color: #1E311B;
      font-size: 16px;
      font-weight: 750;
    }
    .email-body p { margin: 0 0 14px; }
    .email-body a { color: #C45500; font-weight: 650; text-decoration: none; }
    .email-body ul, .email-body ol { margin: 0 0 16px; padding-left: 20px; }
    .email-body li { margin: 0 0 8px; }
    .greeting { margin: 0 0 10px !important; font-size: 17px; color: #1a2418; }
    .lead { margin: 0 0 18px !important; font-size: 16px; color: #3d4a3a; line-height: 1.7; }
    .closing { margin: 22px 0 8px !important; color: #2c3829; }
    .section-label {
      margin: 0 0 10px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #64748b;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .data-card {
      background: #f6f9f5;
      border: 1px solid #e0e8dd;
      border-radius: 14px;
      padding: 6px 18px;
      margin: 18px 0 22px;
    }
    .row {
      padding: 12px 0;
      border-bottom: 1px dashed #d5ddd2;
      font-size: 14px;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .row:last-child { border-bottom: none; }
    .label { color: #64748b; font-weight: 650; display: block; margin-bottom: 2px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
    .value { color: #1e293b; font-weight: 700; font-size: 15px; }
    .info-box {
      background: #fff8f2;
      border: 1px solid #f0dcc8;
      border-radius: 12px;
      padding: 16px 18px;
      margin: 18px 0 22px;
      font-size: 14px;
      color: #3d4a3a;
      line-height: 1.7;
    }
    .info-box.success { background: #f1faf3; border-color: #cfe8d4; }
    .info-box.warning { background: #fffbeb; border-color: #fde68a; }
    .info-box.danger { background: #fef2f2; border-color: #fecaca; }
    .info-box strong { color: #1E311B; }
    .quote-box {
      background: #fbf6ee;
      border-left: 4px solid #FF6F00;
      border-radius: 0 12px 12px 0;
      padding: 16px 18px;
      margin: 16px 0 22px;
      font-size: 14px;
      color: #2c3829;
      line-height: 1.7;
      white-space: pre-wrap;
    }
    .btn {
      display: inline-block;
      background: #FF6F00;
      color: #ffffff !important;
      padding: 14px 26px;
      border-radius: 8px;
      text-decoration: none !important;
      font-weight: 750;
      font-size: 15px;
      margin: 6px 8px 6px 0;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .btn-secondary {
      display: inline-block;
      background: #263E22;
      color: #ffffff !important;
      padding: 14px 26px;
      border-radius: 8px;
      text-decoration: none !important;
      font-weight: 750;
      font-size: 15px;
      margin: 6px 8px 6px 0;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .cta-row { margin: 8px 0 20px; }
    .badge {
      display: inline-block;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 750;
      background: #fff3e6;
      color: #C45500;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .badge-success { background: #dcfce7; color: #15803d; }
    .badge-error { background: #fee2e2; color: #b91c1c; }
    .badge-warning { background: #fef3c7; color: #b45309; }
    .divider { border: none; border-top: 1px solid #e8eee6; margin: 22px 0; }
    .signature {
      margin: 8px 0 6px;
      padding-top: 8px;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .signature-close { margin: 0 0 10px !important; color: #2c3829; }
    .signature-name { margin: 0 0 2px !important; color: #1E311B; font-size: 16px; }
    .signature-role { margin: 0 0 14px !important; color: #64748b; font-size: 13px; }
    .signature-card {
      background: #f6f9f5;
      border: 1px solid #e0e8dd;
      border-radius: 12px;
      padding: 14px 16px;
    }
    .signature-brand { margin: 0 0 4px !important; color: #1E311B; font-size: 15px; }
    .signature-line { margin: 0 0 4px !important; font-size: 13px; color: #475569; }
    .signature-hours { margin: 8px 0 0 !important; font-size: 12px; color: #94a3b8; }
    .email-footer {
      background: #f0f3ef;
      padding: 22px 28px 26px;
      text-align: center;
      font-size: 13px;
      color: #64748b;
      font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
    }
    .email-footer a { color: #263E22; font-weight: 700; text-decoration: none; }
    .trust { margin-top: 12px; font-size: 12px; color: #94a3b8; line-height: 1.55; }
    @media only screen and (max-width: 600px) {
      .email-shell { padding: 0 !important; }
      .email-card { border-radius: 0 !important; border-left: 0 !important; border-right: 0 !important; }
      .brand-bar, .email-body, .email-footer { padding-left: 20px !important; padding-right: 20px !important; }
      .btn, .btn-secondary { display: block !important; width: 100% !important; box-sizing: border-box !important; text-align: center !important; margin: 8px 0 !important; }
    }
  </style>
</head>
<body>
  <div class="email-shell">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center">
          <table role="presentation" class="email-card" width="640" cellspacing="0" cellpadding="0" border="0">
            <tr>
              <td class="brand-bar">
                <img src="https://tanzaniasafarimagic.com/images/logo.png" width="56" height="56" alt="Tanzania Safari Magic">
                {{#if header}}
                <h1>{{header.title}}</h1>
                {{#if header.subtitle}}<p>{{header.subtitle}}</p>{{/if}}
                {{else}}
                <h1>Tanzania Safari Magic</h1>
                <p>Private safaris from Arusha · Serengeti · Ngorongoro · Kilimanjaro · Zanzibar</p>
                {{/if}}
              </td>
            </tr>
            <tr><td class="accent-line"></td></tr>
            <tr>
              <td class="email-body">
                {{{body}}}
                {{#unless hide_signature}}
                {{> signature}}
                {{/unless}}
              </td>
            </tr>
            <tr>
              <td class="email-footer">
                {{#if footer}}
                  {{{footer}}}
                {{else}}
                  <p style="margin:0 0 8px;"><strong style="color:#1E311B;">Tanzania Safari Magic</strong> — your hosts in Arusha</p>
                  <p style="margin:0 0 10px;">
                    <a href="mailto:info@tanzaniasafarimagic.com">info@tanzaniasafarimagic.com</a>
                    &nbsp;·&nbsp;
                    <a href="https://wa.me/255695108009">+255 695 108 009</a>
                    &nbsp;·&nbsp;
                    <a href="{{#if site_url}}{{site_url}}{{else}}https://tanzaniasafarimagic.com{{/if}}">Website</a>
                  </p>
                  <p style="margin:0 0 8px;">
                    <a href="{{#if site_url}}{{site_url}}{{else}}https://tanzaniasafarimagic.com{{/if}}/safaris">Safaris</a> ·
                    <a href="{{#if site_url}}{{site_url}}{{else}}https://tanzaniasafarimagic.com{{/if}}/kilimanjaro">Kilimanjaro</a> ·
                    <a href="{{#if site_url}}{{site_url}}{{else}}https://tanzaniasafarimagic.com{{/if}}/zanzibar">Zanzibar</a> ·
                    <a href="{{#if site_url}}{{site_url}}{{else}}https://tanzaniasafarimagic.com{{/if}}/booking">Free quote</a>
                  </p>
                  <p class="trust">
                    Licensed local safari operator · Transparent private itineraries · No online card charge for quote requests<br>
                    &copy; {{#if year}}{{year}}{{else}}2026{{/if}} Tanzania Safari Magic. All rights reserved.
                  </p>
                {{/if}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
