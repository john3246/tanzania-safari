{{#with payment}}
<p class="greeting"><strong>Payment failed</strong></p>
<p class="lead">A guest payment attempt failed. Follow up promptly so the booking is not left in limbo.</p>

<p class="section-label">Payment attempt</p>
<div class="data-card">
  {{#if payment_id}}
  <div class="row"><span class="label">Payment ID</span><span class="value">{{payment_id}}</span></div>
  {{/if}}
  <div class="row"><span class="label">Guest</span><span class="value">{{customer_name}}</span></div>
  <div class="row"><span class="label">Email</span><span class="value"><a href="mailto:{{customer_email}}">{{customer_email}}</a></span></div>
  {{#if booking_reference}}
  <div class="row"><span class="label">Booking reference</span><span class="value">{{booking_reference}}</span></div>
  {{/if}}
  <div class="row"><span class="label">Amount</span><span class="value">${{formatPrice amount}} USD</span></div>
  <div class="row"><span class="label">Status</span><span class="value"><span class="badge badge-error">Failed</span></span></div>
</div>

<div class="cta-row">
  <a href="{{admin_url}}/bookings" class="btn">Open in dashboard</a>
  <a href="mailto:{{customer_email}}" class="btn-secondary">Contact guest</a>
</div>
{{/with}}
