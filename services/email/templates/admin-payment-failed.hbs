{{#with payment}}
<p><strong>Payment Failed</strong></p>

<div class="divider"></div>

<div class="row">
  <span class="label">Payment ID</span>
  <span class="value">{{payment_id}}</span>
</div>
<div class="row">
  <span class="label">Customer</span>
  <span class="value">{{customer_name}}</span>
</div>
<div class="row">
  <span class="label">Email</span>
  <span class="value">{{customer_email}}</span>
</div>
<div class="row">
  <span class="label">Booking Reference</span>
  <span class="value">{{booking_reference}}</span>
</div>
<div class="row">
  <span class="label">Amount</span>
  <span class="value">${{formatPrice amount}} USD</span>
</div>
<div class="row">
  <span class="label">Status</span>
  <span class="value"><span class="badge badge-error">Failed</span></span>
</div>

<div class="divider"></div>

<div style="text-align: center; margin-top: 24px;">
  <a href="{{admin_url}}/bookings" class="btn">View in Dashboard</a>
</div>
{{/with}}
