{{#with payment}}
<p>Dear <strong>{{customer_name}}</strong>,</p>

<p>We were unable to process your payment. This may be due to insufficient funds, an expired card, or a technical issue.</p>

<div class="divider"></div>

<div class="row">
  <span class="label">Payment ID</span>
  <span class="value">{{payment_id}}</span>
</div>
<div class="row">
  <span class="label">Booking Reference</span>
  <span class="value">#{{booking_reference}}</span>
</div>
<div class="row">
  <span class="label">Amount</span>
  <span class="value">${{formatPrice amount}} USD</span>
</div>
<div class="row">
  <span class="label">Status</span>
  <span class="value"><span class="badge badge-error">Failed</span></span>
</div>

<div class="divider"></div>

<p>Please try again with a different payment method or contact us for assistance.</p>
{{/with}}
